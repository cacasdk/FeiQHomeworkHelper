                                                IDM_SEND_USERCHANGETIP
        MENUITEM SEPARATOR
        MENUITEM "按Ctrl+Enter发送消息",        IDM_SEND_CTRLENTER
        MENUITEM "按Enter发送消息",             IDM_SEND_ENTER
    END
END


