IDR_MENU1 MENU DISCARDABLE 
BEGIN
    POPUP "MENU"
    BEGIN
        MENUITEM "发送文件",                    IDM_SEND_FILES
        MENUITEM "发送目录",                    IDM_SEND_DIRS
        MENUITEM SEPARATOR
