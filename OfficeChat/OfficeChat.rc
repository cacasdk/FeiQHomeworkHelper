/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_DIALOG_OFFICECHAT DIALOGEX 0, 0, 333, 225
STYLE DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "办公对话模式----飞秋(FeiQ)"
FONT 10, "宋体"
BEGIN
    EDITTEXT        IDC_EDIT_SEND,5,145,201,63,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "发送",IDC_BUTTON1,209,145,20,64
    EDITTEXT        IDC_EDIT_SHOWALL,5,3,227,117,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN | 
                    WS_VSCROLL
    GROUPBOX        "选择要发送的用户:",IDC_STATIC_USERFRAME,235,2,95,220
    EDITTEXT        IDC_EDIT_USER,5,121,226,23,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_READONLY | ES_WANTRETURN
    CONTROL         "List1",IDC_LIST1,"SysListView32",LVS_REPORT | WS_BORDER | 
                    WS_TABSTOP,241,13,86,193
    EDITTEXT        IDC_EDIT1,241,208,51,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "刷新",IDC_BUTTON2,295,207,30,12
    EDITTEXT        IDC_EDIT_STATUS,5,211,200,13,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN
    PUSHBUTTON      "",IDC_BUTTON_SENDFILE,5,145,203,12,NOT WS_VISIBLE
    PUSHBUTTON      ">>",IDC_BUTTON_MORE,210,212,18,12
END

IDD_DIALOG_FILES DIALOG DISCARDABLE  0, 0, 208, 182
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "要发送的文件列表："
FONT 9, "宋体"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,37,161,50,14
    PUSHBUTTON      "取消",IDCANCEL,99,161,50,14
    CONTROL         "List1",IDC_LIST_FILE,"SysListView32",LVS_REPORT | 
                    WS_BORDER | WS_TABSTOP,7,20,146,130
    LTEXT           "要发送的文件列表:",IDC_STATIC,7,7,82,10
    PUSHBUTTON      "增加文件",IDC_BUTTON1,164,43,37,18
    PUSHBUTTON      "增加目录",IDC_BUTTON3,164,73,37,18
    PUSHBUTTON      "删除",IDC_BUTTON4,164,107,37,18
END

IDD_DIALOG_SET DIALOG DISCARDABLE  0, 0, 196, 281
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "宋体"
BEGIN
    DEFPUSHBUTTON   "确定",IDOK,34,260,50,14
    PUSHBUTTON      "取消",IDCANCEL,109,260,50,14
    PUSHBUTTON      "消息发送框字体设置",IDC_BUTTON1,25,47,152,21
    PUSHBUTTON      "消息接收框字体设置",IDC_BUTTON3,25,17,152,21
    LTEXT           "主程序消息内容处理方式：",IDC_STATIC,25,79,111,8
    COMBOBOX        IDC_COMBO1,25,92,152,213,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    CONTROL         "设置成办公模式对话",IDC_CHECK_OFFICECHAT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,25,242,144,14
    CONTROL         "接Ctrl+Enter键发送消息",IDC_RADIO1,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,25,185,129,12
    CONTROL         "接Enter键发送消息",IDC_RADIO2,"Button",
                    BS_AUTORADIOBUTTON,25,199,129,12
    CONTROL         "退出时保存窗口大小",IDC_CHECK_SAVEWNDSIZE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,25,213,144,14
    LTEXT           "聊天记录用户名称显示:",IDC_STATIC,25,109,124,8
    LISTBOX         IDC_LIST2,27,120,150,58,LBS_OWNERDRAWFIXED | 
                    LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | 
                    WS_TABSTOP
    CONTROL         "发送时，选择的用户与上次不一样时，提示",
                    IDC_CHECK_USERCHANGETIP,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,25,227,169,14
END


